{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/env.d.ts",
    "e2e/automation/**/*.ts",
    "e2e/scenarios/**/*.ts",
    "e2e/browser/**/*.ts",
    "e2e/runner/**/*.ts",
    "scripts/e2e-comment.ts"
  ]
}
