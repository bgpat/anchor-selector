{
  "name": "@bgpat/anchor-selector",
  "version": "0.11.1",
  "description": "The web-extension to select anchor element.",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev-all.ts",
    "dev:chrome": "wxt -b chrome -p 3000",
    "dev:firefox": "wxt -b firefox -p 3001",
    "build": "npm-run-all build:chrome build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "npm-run-all zip:chrome zip:firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "npm-run-all build",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "playwright test --project=chrome",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:report": "playwright show-report e2e/report",
    "lint": "npm-run-all lint:*",
    "lint:webext": "wxt build -b firefox && web-ext lint -s .output/firefox-mv2 --warnings-as-errors=false",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "linthtml \"src/entrypoints/**/*.html\"",
    "lint:js": "eslint src e2e scripts",
    "publish": "npm-run-all publish:*",
    "publish:firefox": "web-ext-submit --api-key=$JWT_ISSUER --api-secret=$JWT_SECRET",
    "publish:chrome": "chrome-webstore-upload upload --source .output/*-chrome.zip --auto-publish",
    "postversion": "echo \"Version is read from package.json by WXT\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgpat/anchor-selector.git"
  },
  "keywords": [
    "webextension",
    "firefox-addon"
  ],
  "author": "bgpat",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bgpat/anchor-selector/issues"
  },
  "homepage": "https://github.com/bgpat/anchor-selector#readme",
  "devDependencies": {
    "@linthtml/linthtml": "0.10.2",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@wxt-dev/module-react": "1.2.2",
    "chrome-webstore-upload": "6.0.1",
    "chrome-webstore-upload-cli": "4.0.2",
    "color": "5.0.3",
    "dot-json": "1.3.0",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.3",
    "playwright-webextext": "^0.0.5",
    "prettier": "3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "web-ext": "10.7.0",
    "web-ext-submit": "7.8.0",
    "wxt": "0.21.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,json,css,md}": [
      "prettier --write",
      "git add"
    ]
  }
}
